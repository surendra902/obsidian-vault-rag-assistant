# ---------------------------------------------------------------------------
# Pick ONE provider. If both are set, Anthropic wins.
# ---------------------------------------------------------------------------

# Option A -- Claude. Strongest grounding: the API returns native citation
# objects, so a cited source cannot be invented.
#
# Deliberately NOT named ANTHROPIC_API_KEY: an ambient ANTHROPIC_API_KEY /
# ANTHROPIC_BASE_URL in the environment must never silently reroute this app
# through a third-party proxy. The app pins base_url=https://api.anthropic.com
# explicitly and reads only this variable.
MY_ANTHROPIC_KEY=

# Option B -- any OpenAI-compatible endpoint (OpenRouter, NVIDIA Build, vLLM,
# LM Studio, ...). Citations are reconstructed from [n] markers instead of
# native citation objects; out-of-range markers are dropped.
#
# OpenRouter (default base URL):
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# NVIDIA Build instead:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODELS=openai/gpt-oss-120b,nvidia/nemotron-3-super-120b-a12b
# (both verified 2026-09-02; faster than OpenRouter free, separate quota)
#
# Comma-separated fallback chain, tried in order. Free tiers return 429
# unpredictably, so more than one entry is worth having. Defaults to:
# LLM_MODELS=nvidia/nemotron-3.5-lightning:free,poolside/laguna-s-2.1:free,liquid/lfm-2.5-2.6b:free

# With neither key set the app runs in extractive mode (retrieval + verbatim top
# chunks). /ask live answers, citations, and /agent all require a key.
