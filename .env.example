# Your own Anthropic API key. Deliberately NOT named ANTHROPIC_API_KEY: an
# ambient ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL in the environment must never
# silently reroute this app through a third-party proxy. The app pins
# base_url=https://api.anthropic.com explicitly and reads only this variable.
#
# Without it the app runs in extractive mode (retrieval + verbatim top chunks);
# /ask live answers, citations, and /agent all require it.
MY_ANTHROPIC_KEY=
